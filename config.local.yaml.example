paths:
  raw_root: /Volumes/Music/Podcast/Sex Drunks/02_recordings

auphonic:
  enabled: true
  api_key: "replace-me"
  request_timeout_seconds: 600
  preset_ids:
    transcript_refresh: "replace-me"
    speakers_1: "replace-me"
    speakers_2: "replace-me"
    speakers_3: "replace-me"
    speakers_4: "replace-me"
  # UUID of the Amazon S3 external service registered in Auphonic
  # (Settings -> External Services); productions attach S3 audio through it.
  s3_service_id: "replace-me"

cozytrack:
  base_url: http://localhost:3000
  api_key: "replace-me"
  download_subdir: cozytrack
  # HTTP timeout (seconds) for Cozytrack API calls and S3 downloads.
  request_timeout_seconds: 600

storage:
  enabled: true
  # Private Podline media bucket. Credentials come from the standard AWS
  # chain (env vars, ~/.aws profile, or an IAM role when hosted).
  bucket: "replace-me"
  # Leave empty to use the AWS default region for the active profile.
  region: us-west-2
  # Optional key prefix inside the bucket; usually empty.
  key_prefix: ""
  # AWS named profile with long-term keys (scripts/setup_iam_users.sh
  # creates the scoped 'podline' user). Empty uses the default chain.
  profile: podline
